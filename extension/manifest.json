{
  "manifest_version": 3,
  "name": "Jagoda–Nina Bridge (eksperyment)",
  "version": "0.2.0",
  "description": "Ręczny transport dwóch wiadomości między Jagodą i Niną przez serwer. Bez dostępu do rozmów ChatGPT.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jagoda–Nina Bridge",
    "default_popup": "popup.html"
  }
}
