{
  "manifest_version": 3,
  "name": "Jagoda–Nina Bridge (eksperyment)",
  "version": "0.3.6",
  "description": "Jagoda–Nina Bridge: obsługa sterowania z kart URL hash, czytelne błędy START i bezpieczne zachowanie tokenu.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Otwórz / zamknij panel Jagoda–Nina"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
