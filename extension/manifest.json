{
  "manifest_version": 3,
  "name": "Jagoda–Nina Bridge (eksperyment)",
  "version": "0.3.0",
  "description": "Eksperymentalny transport Nina–Jagoda oraz adapter jednej dedykowanej rozmowy ChatGPT. Bez dostępu do innych rozmów.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jagoda–Nina Bridge",
    "default_popup": "popup.html"
  }
}
